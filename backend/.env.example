# Comma-separated list of origins allowed to call the API (the Vite dev server).
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Directory where downloaded repository ZIPs are stored and reused.
# Relative paths resolve from the directory uvicorn runs in.
STORAGE_DIR=storage

# Generation provider: auto, gemini, or ollama.
# "auto" uses Gemini when GEMINI_API_KEY is set, otherwise local Ollama.
LLM_PROVIDER=auto

# Gemini API key. Leave empty to keep using local Ollama with LLM_PROVIDER=auto.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# Optional Gemini input-context override for repository analysis. When unset,
# the backend reads inputTokenLimit from the Gemini model metadata.
# GEMINI_NUM_CTX=1048576

# Local Ollama server and model, used when the provider is ollama.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b

# Optional Ollama context window override for repository analysis. When unset,
# the backend reads the active model's runtime context from Ollama (/api/ps).
# Set this when you want analysis to use a specific num_ctx value.
# OLLAMA_NUM_CTX=8192
